{
  "name": "specillum",
  "version": "0.1.0",
  "description": "MCP server that gives every AI agent (Claude Code, Codex, Cursor) its own isolated browser pod inside your real, logged-in Chrome.",
  "type": "module",
  "bin": {
    "specillum": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CITATION.cff",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "smoke": "node test/smoke.mjs",
    "test:live": "node test/live.mjs",
    "test:modes": "node test/modes.mjs",
    "test:data": "node test/data.mjs",
    "test:recipes": "node test/recipes.mjs",
    "test:features": "node test/features.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "browser-automation",
    "ai-agent",
    "agent-browser",
    "claude-code",
    "codex",
    "cursor",
    "chrome",
    "cdp",
    "playwright",
    "logged-in-browser",
    "browser-isolation",
    "multi-agent"
  ],
  "author": "Jason (https://github.com/jasonwpgml)",
  "license": "Apache-2.0",
  "homepage": "https://github.com/jasonwpgml/specillum#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jasonwpgml/specillum.git"
  },
  "bugs": {
    "url": "https://github.com/jasonwpgml/specillum/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "playwright-core": "^1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
